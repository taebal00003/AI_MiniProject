import os
import urllib.request
import gzip
import numpy as np
import matplotlib.pyplot as plt
from collections import OrderedDict

from common.layers import Convolution, Relu, Pooling, Affine, SoftmaxWithLoss, Dropout
from common.optimizer import Adam

# ==========================================
# 1. Fashion MNIST 데이터 로더
# ==========================================
url_base = 'http://fashion-mnist.s3-website.eu-central-1.amazonaws.com/'
key_file = {
    'train_images': 'train-images-idx3-ubyte.gz',
    'train_labels': 'train-labels-idx1-ubyte.gz',
    'test_images': 't10k-images-idx3-ubyte.gz',
    'test_labels': 't10k-labels-idx1-ubyte.gz'
}


def download_fashion_mnist():
    for filename in key_file.values():
        if not os.path.exists(filename):
            print(f"다운로드 중: {filename}...")
            urllib.request.urlretrieve(url_base + filename, filename)
            print("다운로드 완료.")


def load_fashion_mnist():
    download_fashion_mnist()
    with gzip.open(key_file['train_labels'], 'rb') as f:
        t_train = np.frombuffer(f.read(), np.uint8, offset=8)
    with gzip.open(key_file['test_labels'], 'rb') as f:
        t_test = np.frombuffer(f.read(), np.uint8, offset=8)
    with gzip.open(key_file['train_images'], 'rb') as f:
        x_train = np.frombuffer(f.read(), np.uint8, offset=16)
    with gzip.open(key_file['test_images'], 'rb') as f:
        x_test = np.frombuffer(f.read(), np.uint8, offset=16)

    x_train = x_train.reshape(-1, 1, 28, 28)
    x_test = x_test.reshape(-1, 1, 28, 28)
    return (x_train, t_train), (x_test, t_test)


# ==========================================
# 2. 드롭아웃이 추가된 CNN 클래스 정의
# ==========================================
class ConvNetWithDropout:
    """드롭아웃이 적용된 합성곱 신경망"""

    def __init__(self, input_dim=(1, 28, 28),
                 conv_param={'filter_num': 30, 'filter_size': 5, 'pad': 0, 'stride': 1},
                 hidden_size=100, output_size=10, weight_init_std=0.01, dropout_ratio=0.5):

        filter_num = conv_param['filter_num']
        filter_size = conv_param['filter_size']
        filter_pad = conv_param['pad']
        filter_stride = conv_param['stride']
        input_size = input_dim[1]
        conv_output_size = (input_size - filter_size + 2 * filter_pad) / filter_stride + 1
        pool_output_size = int(filter_num * (conv_output_size / 2) * (conv_output_size / 2))

        # 가중치 초기화
        self.params = {}
        self.params['W1'] = weight_init_std * np.random.randn(filter_num, input_dim[0], filter_size, filter_size)
        self.params['b1'] = np.zeros(filter_num)
        self.params['W2'] = weight_init_std * np.random.randn(pool_output_size, hidden_size)
        self.params['b2'] = np.zeros(hidden_size)
        self.params['W3'] = weight_init_std * np.random.randn(hidden_size, output_size)
        self.params['b3'] = np.zeros(output_size)

        # 계층 생성 (Dropout 추가)
        self.layers = OrderedDict()
        self.layers['Conv1'] = Convolution(self.params['W1'], self.params['b1'], conv_param['stride'],
                                           conv_param['pad'])
        self.layers['Relu1'] = Relu()
        self.layers['Pool1'] = Pooling(pool_h=2, pool_w=2, stride=2)
        self.layers['Affine1'] = Affine(self.params['W2'], self.params['b2'])
        self.layers['Relu2'] = Relu()
        self.layers['Dropout1'] = Dropout(dropout_ratio)  # <-- 첫 번째 Affine 계층 뒤에 드롭아웃 적용!
        self.layers['Affine2'] = Affine(self.params['W3'], self.params['b3'])

        self.last_layer = SoftmaxWithLoss()

    def predict(self, x, train_flg=False):
        """추론을 수행합니다. train_flg로 학습/테스트 모드를 구분합니다."""
        for key, layer in self.layers.items():
            if "Dropout" in key:
                x = layer.forward(x, train_flg)  # 드롭아웃은 상태를 알아야 함
            else:
                x = layer.forward(x)
        return x

    def loss(self, x, t):
        """손실을 구합니다 (학습 모드)."""
        y = self.predict(x, train_flg=True)
        return self.last_layer.forward(y, t)

    def accuracy(self, x, t, batch_size=100):
        """정확도를 구합니다 (테스트 모드)."""
        if t.ndim != 1: t = np.argmax(t, axis=1)
        acc = 0.0
        for i in range(int(x.shape[0] / batch_size)):
            tx = x[i * batch_size:(i + 1) * batch_size]
            tt = t[i * batch_size:(i + 1) * batch_size]
            y = self.predict(tx, train_flg=False)  # 평가할 때는 모든 뉴런 사용
            y = np.argmax(y, axis=1)
            acc += np.sum(y == tt)
        return acc / x.shape[0]

    def gradient(self, x, t):
        """오차역전파법으로 기울기를 구합니다."""
        self.loss(x, t)  # 순전파

        dout = 1
        dout = self.last_layer.backward(dout)

        layers = list(self.layers.values())
        layers.reverse()
        for layer in layers:
            dout = layer.backward(dout)  # 역전파

        grads = {}
        grads['W1'], grads['b1'] = self.layers['Conv1'].dW, self.layers['Conv1'].db
        grads['W2'], grads['b2'] = self.layers['Affine1'].dW, self.layers['Affine1'].db
        grads['W3'], grads['b3'] = self.layers['Affine2'].dW, self.layers['Affine2'].db
        return grads


# ==========================================
# 3. 데이터 준비 및 초기화
# ==========================================
print("1. Fashion MNIST 데이터셋을 준비하는 중...")
(x_train, t_train), (x_test, t_test) = load_fashion_mnist()

x_train = x_train.astype(np.float32) / 255.0
x_test = x_test.astype(np.float32) / 255.0
t_train = np.eye(10)[t_train]
t_test = np.eye(10)[t_test]

print("2. 네트워크 및 하이퍼파라미터 초기화 중...")
network = ConvNetWithDropout(input_dim=(1, 28, 28), hidden_size=256, dropout_ratio=0.25)
optimizer = Adam(lr=0.001)

max_epochs = 20
batch_size = 100
train_size = x_train.shape[0]
iter_per_epoch = max(train_size // batch_size, 1)

epoch_loss_list = []
train_acc_list = []
test_acc_list = []

# 조기 종료(Early Stopping) 
patience = 3
best_test_acc = 0.0
early_stop_counter = 0

print(f"3. 드롭아웃 및 개선된 평가 방식으로 학습 시작! (최대 {max_epochs} 에폭)")
print("-" * 65)

# ==========================================
# 4. 학습 루프
# ==========================================
for epoch in range(max_epochs):
    idx = np.random.permutation(train_size)
    x_train = x_train[idx]
    t_train = t_train[idx]
    temp_loss = []

    for i in range(iter_per_epoch):
        batch_mask = np.arange(i * batch_size, (i + 1) * batch_size)
        x_batch = x_train[batch_mask]
        t_batch = t_train[batch_mask]

        grads = network.gradient(x_batch, t_batch)
        optimizer.update(network.params, grads)

        loss = network.loss(x_batch, t_batch)
        temp_loss.append(loss)

    # === 1 에폭 종료 후 평가 ===
    avg_epoch_loss = np.mean(temp_loss)
    epoch_loss_list.append(avg_epoch_loss)

    # 연산 속도 최적화: 훈련 정확도는 1,000개만 샘플링, 테스트는 전체(10,000개)로 확실하게 검증
    train_sample_idx = np.random.choice(train_size, 1000)
    train_acc = network.accuracy(x_train[train_sample_idx], t_train[train_sample_idx])

    # 전체 테스트 데이터를 사용하여 노이즈(운) 배제
    test_acc = network.accuracy(x_test, t_test)

    train_acc_list.append(train_acc)
    test_acc_list.append(test_acc)

    print(f"[Epoch {epoch + 1:2d}/{max_epochs}] 평균 손실: {avg_epoch_loss:.4f} | "
          f"훈련 정확도: {train_acc:.4f} | 테스트 정확도: {test_acc:.4f}")

    # === 개선된 조기 종료 체크 ===
    if test_acc > best_test_acc:
        best_test_acc = test_acc
        early_stop_counter = 0
    else:
        early_stop_counter += 1
        print(f"  -> 주의: 테스트 정확도 개선 안 됨 (카운트: {early_stop_counter}/{patience})")

        if early_stop_counter >= patience:
            print(f"\n🚨 [조기 종료 발동] 에폭 {epoch + 1}에서 학습 중단. (최고 테스트 정확도: {best_test_acc:.4f})")
            break

print("-" * 65)
print("학습이 완료되었습니다. 그래프를 생성합니다.")

# ==========================================
# 5. 결과 시각화
# ==========================================
fig, ax1 = plt.subplots(figsize=(10, 6))
actual_epochs = len(epoch_loss_list)
epochs_x = np.arange(1, actual_epochs + 1)

ax1.plot(epochs_x, epoch_loss_list, color='red', marker='x', linestyle='--', label='Train Loss')
ax1.set_xlabel('Epochs', fontsize=12)
ax1.set_ylabel('Loss', color='red', fontsize=12)
ax1.tick_params(axis='y', labelcolor='red')
ax1.set_xticks(epochs_x)
ax1.grid(True, linestyle=':', alpha=0.6)

ax2 = ax1.twinx()
ax2.plot(epochs_x, train_acc_list, color='blue', marker='o', label='Train Accuracy')
ax2.plot(epochs_x, test_acc_list, color='orange', marker='s', label='Test Accuracy')
ax2.set_ylabel('Accuracy', color='blue', fontsize=12)
ax2.tick_params(axis='y', labelcolor='blue')

lines_1, labels_1 = ax1.get_legend_handles_labels()
lines_2, labels_2 = ax2.get_legend_handles_labels()
ax1.legend(lines_1 + lines_2, labels_1 + labels_2, loc='center right', framealpha=0.9)

plt.title('Training/Test Accuracy and Loss over Epochs (Dropout & Early Stopping)', fontsize=14)
fig.tight_layout()
plt.show()
